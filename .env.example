# ---------------------------------------------------------------------------
# Copier en .env (jamais commité) : cp .env.example .env
# ---------------------------------------------------------------------------

# --- MLflow ---------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5050
MLFLOW_EXPERIMENT_NAME=hdd-rul

# --- Prefect --------------------------------------------------------------
PREFECT_API_URL=http://localhost:4200/api

# --- PostgreSQL (traces API) ---------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hdd_rul
POSTGRES_USER=hdd
POSTGRES_PASSWORD=change-me

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8001
API_WORKERS=1

# --- Alertes (webhook Teams / Slack ; absent = alertes seulement en logs) ---
# À définir dans .env (non versionné), pas ici. `mise` exporte ce fichier dans
# tout le shell, et Docker Compose donne la priorité au shell sur .env : une
# ligne `HDD_RUL_WEBHOOK_URL=` vide ici effaçait l'URL de .env dans les conteneurs.
# HDD_RUL_WEBHOOK_URL=https://...
# Test du rendu de la carte : `mise run alert:test`.
# Liens directs des alertes (défaut : localhost, cf. config/base.yaml, alerts.links) :
# HDD_RUL_PREFECT_UI_URL=http://localhost:4200
# HDD_RUL_MLFLOW_UI_URL=http://localhost:5050
# HDD_RUL_GRAFANA_URL=http://localhost:3000
# HDD_RUL_ALERT_ENV=poste-demo         # défaut : utilisateur@machine

# --- Configuration applicative -------------------------------------------
# HDD_RUL_CONFIG et HDD_RUL_DATA_DIR ne sont volontairement PAS exportés ici :
# `mise` charge ce fichier dans tout le shell, et HDD_RUL_DATA_DIR l'emporte sur
# le `paths.root` d'un overlay. `--config config/demo.yaml` (scripts de démo,
# tests) écrivait alors dans les vraies données de data/ au lieu de data/demo/.
# Par défaut : config/base.yaml et data/. Les conteneurs fixent les leurs
# (compose.yml). À définir à la main seulement pour un besoin ponctuel.
